{
  "name": "socket.io-valkey-adapter",
  "version": "0.1.3",
  "description": "The Socket.IO Valkey adapter, allowing to broadcast events between several Socket.IO servers",
  "license": "MIT",
  "homepage": "https://valkey.srinudesetti.in/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webdevelopersrinu/socket.io-valkey-adapter.git"
  },
  "bugs": {
    "url": "https://github.com/webdevelopersrinu/socket.io-valkey-adapter/issues"
  },
  "keywords": [
    "socket.io",
    "valkey",
    "adapter",
    "pubsub",
    "websocket",
    "iovalkey"
  ],
  "files": [
    "dist/"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "compile": "rimraf ./dist && tsc",
    "test": "tsc && nyc mocha --bail --timeout 5000 --require ts-node/register test/index.ts",
    "format:check": "prettier --parser typescript --check 'lib/**/*.ts' 'test/**/*.ts'",
    "format:fix": "prettier --parser typescript --write 'lib/**/*.ts' 'test/**/*.ts'",
    "prepack": "npm run compile"
  },
  "dependencies": {
    "debug": "~4.3.1",
    "notepack.io": "~3.0.1",
    "uid2": "1.0.0"
  },
  "peerDependencies": {
    "socket.io-adapter": "^2.5.4"
  },
  "devDependencies": {
    "@types/expect.js": "^0.3.29",
    "@types/mocha": "^8.2.1",
    "@types/node": "^14.14.7",
    "expect.js": "0.3.1",
    "iovalkey": "^0.3.0",
    "mocha": "^10.1.0",
    "nyc": "^15.1.0",
    "prettier": "^2.8.7",
    "rimraf": "^5.0.5",
    "socket.io": "^4.6.1",
    "socket.io-client": "^4.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.5"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
